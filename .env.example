# CalDev Environment Configuration
# Copy this file to .env and update values for your environment.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_PREFORK=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=caldev
DB_PASSWORD=caldev
DB_NAME=caldev
DB_SCHEMA=caldev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Valkey / Redis (wire-protocol compatible)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
# Use the SAME secret and issuer as your mail/other services.
# The server REFUSES TO START while AUTH_JWT_SECRET is empty or this placeholder
# (set ALLOW_INSECURE_DEFAULTS=true to bypass in local development only).
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ISSUER=your-shared-issuer
# Reject tokens that have no exp claim (default true)
AUTH_REQUIRE_EXP=true
# ALLOW_INSECURE_DEFAULTS=false

# Team availability: let users with the same mail_accounts.tenant_name see each other's
# free/busy without an explicit share (default false)
AVAILABILITY_ORG_VISIBLE=false
# Keep-alive interval for the SSE stream /jmap/eventsource (seconds)
# SSE_HEARTBEAT_SECONDS=20
AUTH_TOKEN_EXPIRY=24h
AUTH_OAUTH2_ENABLED=false
AUTH_BASIC_ENABLED=true

# Background Workers
WORKER_CONCURRENCY=4
WORKER_QUEUE_PREFIX=caldev:jobs
WORKER_RETRY_MAX=3
WORKER_RETRY_DELAY=5s
WORKER_SHUTDOWN_TIMEOUT=10s

# Outbound Invitations & Email
# Order for each invitation / update / cancellation / RSVP reply email:
#   1. the calendar's own SMTP (BYO), when configured and active — any account
#   2. internal Airsend accounts (mail_accounts.account_origin = 'internal'): signed HTTP call to
#      airsend-api, which DKIM-signs, sends and stores the email in the sender's mailbox.
#      Retried on failure at +5m, +10m, +15m, +25m, +1h (CalDev Valkey), then marked failed.
#      External accounts (created by the onboarding API) need step 1.
#   3. legacy, only when AIRSEND_INTERNAL_URL is empty: Redis Pub/Sub `calendar:mail` on REDIS_URL
AIRSEND_INTERNAL_URL=https://api.airsend.in/api/v1/internal/calendar/mail
# Same values as airsend-api's CALDEV_INTERNAL_TOKEN / CALDEV_INTERNAL_SECRET (openssl rand -hex 32)
AIRSEND_INTERNAL_TOKEN=
AIRSEND_INTERNAL_SECRET=
AIRSEND_INTERNAL_TIMEOUT=10s

# TLS
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
