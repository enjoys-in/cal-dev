# CalDev Environment Configuration
# Copy this file to .env and update values for your environment.

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8443
SERVER_READ_TIMEOUT=30s
SERVER_WRITE_TIMEOUT=60s
SERVER_IDLE_TIMEOUT=120s
SERVER_SHUTDOWN_TIMEOUT=15s
SERVER_PREFORK=false

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=caldev
DB_PASSWORD=caldev
DB_NAME=caldev
DB_SCHEMA=caldev
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

# Valkey / Redis (wire-protocol compatible)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication
# Use the SAME secret and issuer as your mail/other services
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_ISSUER=your-shared-issuer
AUTH_TOKEN_EXPIRY=24h
AUTH_OAUTH2_ENABLED=false
AUTH_BASIC_ENABLED=true

# Background Workers
WORKER_CONCURRENCY=4
WORKER_QUEUE_PREFIX=caldev:jobs
WORKER_RETRY_MAX=3
WORKER_RETRY_DELAY=5s
WORKER_SHUTDOWN_TIMEOUT=10s

# SMTP (for scheduling invitations — processed by background workers)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=calendar@example.com
SMTP_USE_TLS=true

# TLS
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
